<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHost.fs" />
    <Compile Include="TestSupport.fs" />
    <Compile Include="ThemeTests.fs" />
    <Compile Include="MotionAndShaderTests.fs" />
    <Compile Include="ControlsTests.fs" />
    <Compile Include="NavigationAndOverlaysTests.fs" />
    <Compile Include="FlipViewTests.fs" />
    <Compile Include="ListViewTests.fs" />
    <Compile Include="CollectionsTests.fs" />
    <Compile Include="SemanticZoomTests.fs" />
    <Compile Include="NumberRatingTests.fs" />
    <Compile Include="ComboBoxTests.fs" />
    <Compile Include="TiltAndAnimatedOverlaysTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../FunGoo/FunGoo.fsproj" />
    <ProjectReference Include="../../FunGoo.Widgets/FunGoo.Widgets.fsproj" />
    <ProjectReference Include="../../FunGoo.Metro/FunGoo.Metro.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Goo" Version="0.31.0" />
    <PackageReference Include="Goo.Widgets" Version="0.22.2" />
  </ItemGroup>

</Project>
