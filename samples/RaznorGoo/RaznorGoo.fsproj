<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Playback.fs" />
    <Compile Include="FileSystem.fs" />
    <Compile Include="Icons.fs" />
    <Compile Include="Player.fs" />
    <Compile Include="Widgets\MenuBar.fs" />
    <Compile Include="Widgets\MediaList.fs" />
    <Compile Include="Widgets\FilePicker.fs" />
    <Compile Include="Widgets\BottomBar.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FunGoo\FunGoo.fsproj" />
    <ProjectReference Include="..\..\FunGoo.Widgets\FunGoo.Widgets.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Goo" Version="0.5.3" />
    <PackageReference Include="Goo.Svg" Version="0.5.3" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="Mibo.Adaptive" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />
  </ItemGroup>

</Project>
