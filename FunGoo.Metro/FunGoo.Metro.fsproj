<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The package version comes from the latest released section of the
         shared repository changelog (Ionide.KeepAChangelog.Tasks below). -->
    <ChangelogFile>$(MSBuildThisFileDirectory)../CHANGELOG.md</ChangelogFile>
    <Authors>Angel D. Munoz</Authors>
    <Description>Native Metro design system for Goo and FunGoo.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AngelMunoz/FunGoo</RepositoryUrl>
    <PackageTags>goo;fsharp;metro;design-system;widgets;desktop;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MetroAccent.fsi" />
    <Compile Include="MetroAccent.fs" />
    <Compile Include="MetroTokens.fsi" />
    <Compile Include="MetroTokens.fs" />
    <Compile Include="MetroTheme.fsi" />
    <Compile Include="MetroTheme.fs" />
    <Compile Include="MetroMotion.fsi" />
    <Compile Include="MetroMotion.fs" />
    <Compile Include="MetroShader.fsi" />
    <Compile Include="MetroShader.fs" />
    <Compile Include="MetroTilt.fsi" />
    <Compile Include="MetroTilt.fs" />
    <Compile Include="MetroText.fsi" />
    <Compile Include="MetroText.fs" />
    <Compile Include="MetroButton.fsi" />
    <Compile Include="MetroButton.fs" />
    <Compile Include="MetroInputs.fsi" />
    <Compile Include="MetroInputs.fs" />
    <Compile Include="MetroProgress.fsi" />
    <Compile Include="MetroProgress.fs" />
    <Compile Include="MetroPivot.fsi" />
    <Compile Include="MetroPivot.fs" />
    <Compile Include="MetroHub.fsi" />
    <Compile Include="MetroHub.fs" />
    <Compile Include="MetroPanorama.fsi" />
    <Compile Include="MetroPanorama.fs" />
    <Compile Include="MetroSplitView.fsi" />
    <Compile Include="MetroSplitView.fs" />
    <Compile Include="MetroTabView.fsi" />
    <Compile Include="MetroTabView.fs" />
    <Compile Include="MetroBreadcrumbBar.fsi" />
    <Compile Include="MetroBreadcrumbBar.fs" />
    <Compile Include="MetroAppBarParts.fsi" />
    <Compile Include="MetroAppBarParts.fs" />
    <Compile Include="MetroTiles.fsi" />
    <Compile Include="MetroTiles.fs" />
    <Compile Include="MetroOverlays.fsi" />
    <Compile Include="MetroOverlays.fs" />
    <Compile Include="MetroFlyout.fsi" />
    <Compile Include="MetroFlyout.fs" />
    <Compile Include="MetroMessageDialog.fsi" />
    <Compile Include="MetroMessageDialog.fs" />
    <Compile Include="MetroMenus.fsi" />
    <Compile Include="MetroMenus.fs" />
    <Compile Include="MetroTooltip.fsi" />
    <Compile Include="MetroTooltip.fs" />
    <Compile Include="MetroInfoBar.fsi" />
    <Compile Include="MetroInfoBar.fs" />
    <Compile Include="MetroToast.fsi" />
    <Compile Include="MetroToast.fs" />
    <Compile Include="MetroTeachingTip.fsi" />
    <Compile Include="MetroTeachingTip.fs" />
    <Compile Include="MetroFlipView.fsi" />
    <Compile Include="MetroFlipView.fs" />
    <Compile Include="MetroListView.fsi" />
    <Compile Include="MetroListView.fs" />
    <Compile Include="MetroCollections.fsi" />
    <Compile Include="MetroCollections.fs" />
    <Compile Include="MetroLongListSelector.fsi" />
    <Compile Include="MetroLongListSelector.fs" />
    <Compile Include="MetroListPicker.fsi" />
    <Compile Include="MetroListPicker.fs" />
    <Compile Include="MetroTreeView.fsi" />
    <Compile Include="MetroTreeView.fs" />
    <Compile Include="MetroSemanticZoom.fsi" />
    <Compile Include="MetroSemanticZoom.fs" />
    <Compile Include="MetroNumberRating.fsi" />
    <Compile Include="MetroNumberRating.fs" />
    <Compile Include="MetroComboBox.fsi" />
    <Compile Include="MetroComboBox.fs" />
    <Compile Include="MetroLoopingSelector.fsi" />
    <Compile Include="MetroLoopingSelector.fs" />
    <Compile Include="MetroDateTimePickers.fsi" />
    <Compile Include="MetroDateTimePickers.fs" />
    <Compile Include="MetroCalendar.fsi" />
    <Compile Include="MetroCalendar.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Shaders/metro_perspective.slang" />
    <GooShaderEffect Include="Shaders/metro_perspective.slang"
                     Embed="true"
                     TargetPath="FunGoo.Metro.Shaders.metro_perspective.goo-effect"
                     Condition="'$(CompileMetroShaders)' == 'true'" />
    <EmbeddedResource Include="Shaders/metro_perspective.goo-effect"
                      LogicalName="FunGoo.Metro.Shaders.metro_perspective.goo-effect"
                      Condition="Exists('Shaders/metro_perspective.goo-effect') and '$(CompileMetroShaders)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FunGoo\FunGoo.fsproj" />
    <ProjectReference Include="..\FunGoo.Widgets\FunGoo.Widgets.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Goo" Version="0.31.0" />
    <PackageReference Include="Goo.Widgets" Version="0.22.2" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
