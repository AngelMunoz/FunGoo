<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The package version comes from the latest released section of the
         shared repository changelog (Ionide.KeepAChangelog.Tasks below). -->
    <ChangelogFile>$(MSBuildThisFileDirectory)../CHANGELOG.md</ChangelogFile>
    <Authors>Angel D. Munoz</Authors>
    <Description>Native Metro design system for Goo and FunGoo.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AngelMunoz/FunGoo</RepositoryUrl>
    <PackageTags>goo;fsharp;metro;design-system;widgets;desktop;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MetroAccent.fsi" />
    <Compile Include="MetroAccent.fs" />
    <Compile Include="MetroTokens.fsi" />
    <Compile Include="MetroTokens.fs" />
    <Compile Include="MetroTheme.fsi" />
    <Compile Include="MetroTheme.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FunGoo\FunGoo.fsproj" />
    <ProjectReference Include="..\FunGoo.Widgets\FunGoo.Widgets.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Goo" Version="0.31.0" />
    <PackageReference Include="Goo.Widgets" Version="0.22.2" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
