<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The package version comes from the latest released section of the
         repository changelog (Ionide.KeepAChangelog.Tasks below). -->
    <ChangelogFile>$(MSBuildThisFileDirectory)../CHANGELOG.md</ChangelogFile>
    <Authors>Angel D. Munoz</Authors>
    <Description>F# bindings and helpers for the Goo UI framework.</Description>
    <RepositoryUrl>https://github.com/AngelMunoz/FunGoo</RepositoryUrl>
    <PackageTags>goo;fsharp;bindings;desktop;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Widgets/Children.g.fsi" />
    <Compile Include="Widgets/Children.g.fs" />
    <Compile Include="Widgets/Setters.g.fsi" />
    <Compile Include="Widgets/Setters.g.fs" />
    <Compile Include="Widgets/Interop.g.fsi" />
    <Compile Include="Widgets/Interop.g.fs" />
    <Compile Include="Virtual.fsi" />
    <Compile Include="Virtual.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Goo" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
